<?xml version="1.0" encoding="utf-8"?>
<!-- Kiosk mode only needs lock-screen control; no wipe/password policies. -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
        <disable-keyguard-features />
    </uses-policies>
</device-admin>
